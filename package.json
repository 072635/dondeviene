{
  "name": "dondeviene",
  "version": "1.0.0",
  "description": "¿Dónde Viene? Transporte público en tiempo real",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "native:build": "node scripts/build-native.mjs && npx cap sync",
    "android:apk": "npm run native:build && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run native:build && cd android && ./gradlew bundleRelease"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.14.0",
    "web-push": "^3.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  }
}
